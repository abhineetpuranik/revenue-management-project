# =============================================================================
# Root .env.example — expected environment variables for the whole project.
#
# Decision: a single .env.example at the repo root is provided as a reference.
# Each service (backend/, data-pipeline/) also ships its own .env.example with
# only the variables it needs, so contributors working on one module don't
# need to configure unrelated services.
#
# Copy this file to .env (repo root is gitignored) or copy the per-service
# .env.example into that service's folder as .env before running.
# NEVER commit a real .env file.
# =============================================================================

# ── MySQL (shared by data-pipeline and backend) ───────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=revenue_management
DB_GT_NAME=revenue_management_gt
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ── Flask (backend/) ──────────────────────────────────────────────────────────
FLASK_DEBUG=false
FLASK_PORT=5000

# ── LLM explanation layer (data-pipeline/ — Phase 9) ─────────────────────────
#   mock   = offline template sentences, no key needed (default)
#   gemini = Google Gemini, needs LLM_API_KEY
LLM_PROVIDER=mock
LLM_MODEL=gemini-3.5-flash
LLM_API_KEY=your_gemini_api_key_here
