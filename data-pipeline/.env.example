# data-pipeline/.env.example
# Copy this file to data-pipeline/.env and fill in your MySQL credentials.
# NEVER commit .env to version control.

# MySQL — application schema
DB_HOST=localhost
DB_PORT=3306
DB_NAME=revenue_management
DB_GT_NAME=revenue_management_gt
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# LLM explanation layer (Phase 9)
#   LLM_PROVIDER=mock    runs offline with template sentences (no key needed)
#   LLM_PROVIDER=gemini  calls Google Gemini (needs LLM_API_KEY)
LLM_PROVIDER=mock
LLM_MODEL=gemini-3.5-flash
LLM_API_KEY=your_gemini_api_key_here
