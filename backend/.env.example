# Flask
FLASK_DEBUG=false
FLASK_PORT=5000

# CORS — comma-separated, defaults to Angular dev server
CORS_ORIGINS=http://localhost:4200

# MySQL — same instance as the data pipeline
DB_HOST=localhost
DB_PORT=3306
DB_NAME=revenue_management
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Optional overrides for model artifact paths
# (defaults point to data-pipeline/models/artifacts/)
# MODEL_ARTIFACT_PATH=
# MODEL_METADATA_PATH=

# Number of training weeks returned as context in GET /api/forecast/<id>
FORECAST_HISTORY_WEEKS=12

# Pagination
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

# ── Phase 10b: Pricing and explanation endpoints ───────────────────────────
# No new backend variables required.
# Pricing recommendations are read from the pricing_recommendation MySQL table
# (populated by: cd data-pipeline && python -m pricing.run_pricing).
# Explanations are read from the llm_explanation MySQL table
# (populated by: cd data-pipeline && python -m explanations.generate_explanations).
# The LLM API key lives in data-pipeline/.env, not here.
