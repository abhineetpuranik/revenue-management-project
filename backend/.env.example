# Flask configuration
FLASK_DEBUG=false
FLASK_PORT=5000

# MySQL connection (shared with data-pipeline)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=revenue_management
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# LLM API key (for explanation generation — Phase 3+)
LLM_API_KEY=your_llm_api_key_here
